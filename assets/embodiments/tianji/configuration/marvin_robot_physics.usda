    over "joints"
    {
        def PhysicsFixedJoint "base_link_to_tracking_base_link"
        {
            rel physics:body0 = </marvin_robot/base_link>
            rel physics:body1 = </marvin_robot/base_link/tracking_base_link>
            custom string urdf:jointType = "fixed"
            custom float3 urdf:axisLocal = (1, 0, 0)
            point3f physics:localPos0 = (0, 0, -0.1)
            custom point3f urdf:originXyz = (0, 0, -0.1)
            custom quatf urdf:originQuatWxyz = (1, 0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
        def PhysicsFixedJoint "base_link_to_Base_L"
        {
            rel physics:body0 = </marvin_robot/base_link>
            rel physics:body1 = </marvin_robot/base_link/Base_L>
            custom string urdf:jointType = "fixed"
            custom float3 urdf:axisLocal = (1, 0, 0)
            point3f physics:localPos0 = (0, 0.026, 1.121)
            custom point3f urdf:originXyz = (0, 0.026, 1.121)
            custom quatf urdf:originQuatWxyz = (0.707388, -0.706825, 0, 0)
            quatf physics:localRot0 = (0.707388, -0.706825, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
        def PhysicsRevoluteJoint "Joint1_L"
        {
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            rel physics:body0 = </marvin_robot/base_link/Base_L>
            rel physics:body1 = </marvin_robot/base_link/Base_L/Link1_L>
            uniform token physics:axis = "Z"
            custom string urdf:jointType = "revolute"
            custom float3 urdf:axisLocal = (0, 0, 1)
            float physics:lowerLimit = -178.000798
            float physics:upperLimit = 178.000798
            uniform token drive:angular:physics:type = "force"
            float drive:angular:physics:damping = 3
            float drive:angular:physics:maxForce = 108
            point3f physics:localPos0 = (0, 0, 0.1745)
            custom point3f urdf:originXyz = (0, 0, 0.1745)
            custom quatf urdf:originQuatWxyz = (1, 0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
        def PhysicsRevoluteJoint "Joint2_L"
        {
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            rel physics:body0 = </marvin_robot/base_link/Base_L/Link1_L>
            rel physics:body1 = </marvin_robot/base_link/Base_L/Link1_L/Link2_L>
            uniform token physics:axis = "Z"
            custom string urdf:jointType = "revolute"
            custom float3 urdf:axisLocal = (0, 0, 1)
            float physics:lowerLimit = -120.000281
            float physics:upperLimit = -5.729578
            uniform token drive:angular:physics:type = "force"
            float drive:angular:physics:damping = 3
            float drive:angular:physics:maxForce = 108
            point3f physics:localPos0 = (0, 0, 0)
            custom point3f urdf:originXyz = (0, 0, 0)
            custom quatf urdf:originQuatWxyz = (0.707105, 0.707108, 0, 0)
            quatf physics:localRot0 = (0.707105, 0.707108, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
        def PhysicsRevoluteJoint "Joint3_L"
