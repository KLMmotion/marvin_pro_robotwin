#usda 1.0
(
    defaultPrim = "marvin_robot"
    metersPerUnit = 1
    subLayers = [
        @marvin_robot_base.usda@
    ]
    upAxis = "Z"
)

def PhysicsScene "physicsScene"
{
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
}

over "marvin_robot" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    over "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 18.846
        float3 physics:centerOfMass = (0.008199, -0.000005, 0.47835)
        float3 physics:diagonalInertia = (0.463463, 0.46325, 0.377657)
        quatf physics:principalAxes = (0.999994, 0.000037, 0.003136, 0.001737)
        over "collisions"
        {
            over "collision_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                bool physics:collisionEnabled = true
            }
        }
        over "tracking_base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0
            float3 physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0, 0, 0)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }
